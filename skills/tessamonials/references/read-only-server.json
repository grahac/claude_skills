{
  "mcp": {
    "servers": {
      "tessamonials": {
        "url": "https://tessamonials.com/mcp",
        "transport": "streamable-http",
        "enabled": true,
        "auth": "oauth",
        "oauth": {"scope": "tessa:read"},
        "toolFilter": {
          "include": [
            "list_companies",
            "list_campaigns",
            "get_campaign",
            "get_campaign_summary",
            "list_interviews",
            "get_interview",
            "get_transcript",
            "list_testimonials"
          ]
        }
      }
    }
  }
}
